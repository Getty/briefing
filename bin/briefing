#!/bin/sh
# briefing starter: the plugin's `briefing` on PATH and the command its hooks run
# (`briefing hook EVENT`, plugin hooks/hooks.json and hooks/codex-hooks.json). First match wins:
#   1. the release binary of the plugin's version for this platform, cached under
#      <claudeConfigDir>/briefing/bin/<version>/ and rechecked against its pinned checksum;
#   2. else that binary, downloaded only by the SessionStart hook (`hook session-start`; curl,
#      else wget) - never by --version, --help, doctor or any other command, checked against the checksum pinned in the plugin (Linux `sha256sum`, macOS `openssl dgst -sha256`), then cached;
#   3. else the plugin's own fallback, which is the previous behaviour, never unbriefed:
#        hook EVENT     the Python hook, hooks/briefing-preload, with this process's stdin;
#        doctor [...]   the Python doctor, hooks/briefing-preload doctor ...;
#        anything else (--version, --help, notice, doctor --tsv, ...): the plugin's Perl
#        (lib/ + script/briefing), but only when this machine's perl already loads
#        App::Briefing - a system perl normally lacks Moo, Path::Tiny, JSON::MaybeXS and
#        TOML::Tiny, so Perl is no fallback for hooks: a hook must never pay for probing
#        it, and an unloadable Perl would leave the spawn unbriefed;
#   4. else one line saying why: on stderr with exit 1; for `hook ...` the hook's one
#      warning line on stdout instead, with exit 0 (a hook never fails).
# An engine it starts is exec'd with this process's arguments, stdin and stdout untouched.
# The Python hook decides from the payload's hook_event_name, so the EVENT word is not
# passed on; the binary takes it.
# A failed SessionStart provision backs off for 15 minutes per version/platform. Nothing but
# `hook session-start` provisions, so neither an agent spawn nor `briefing --version` or
# `briefing doctor` ever waits for (or triggers) a download. Not covered here:
#   - Windows: Claude Code starts bin/briefing.exe (winlaunch), which runs the briefing-owned
#     bin/briefing-bootstrap.exe; it does the same on its own: pin parsing, WinHTTP download
#     (SessionStart only), BCrypt verification, a private cache, and the Python/Perl fallbacks;
#   - a platform with no pinned binary (anything outside dist.ini's binary_platforms, e.g. FreeBSD or
#     Linux on another architecture): straight to the fallback;
#   - sweeping old versions out of the binary cache.
# Without the pinned checksum file - the state of the repository until a release writes it - or
# with one that is not exactly the canonical five-line manifest, there is no version to look
# for, so neither step 1 nor 2 runs: nothing is downloaded before activation.
#
# No `set -e`/`set -u`: each step falls through to the next, and a hook must exit 0 on every
# path - an unset variable under -u exits 2, which a hook may read as "block".
#
# Bracket expressions spell their characters out ([0123456789], never [0-9]): a range follows
# the locale's collation in some shells - macOS /bin/sh (bash 3.2) lets [A-Za-z0-9] match a
# non-ASCII letter such as U+00E4 in a UTF-8 locale - while an explicit list matches the same
# ASCII set in every locale.
#
# winlaunch: run bin/briefing-bootstrap.exe

# Files created by the starter are private even when its caller has a permissive umask.
umask 077

# --- Settings. Lower case, so none of them reaches a child's environment.

# Trust anchor: the checksums pinned in the plugin, a file next to this starter that
# scripts/import-binary-sums.py writes from the release's SHA256SUMS (the [@Author::GETTY]
# binary workflow attaches it next to the assets). It is strict and canonical: exactly five
# sha256sum lines "<sha256>  briefing-<version>-<os>-<arch>" (".exe" on Windows), lower-case
# hex, LF, in platform_asset's order, all for one version; a missing, extra, reordered or
# different line makes it malformed, and a malformed file pins nothing (read_pins). The version
# comes from the asset names, so this file is the one place a release names what the plugin runs.
# The release's own SHA256SUMS is deliberately not downloaded: it travels with the assets it
# vouches for, so it would prove nothing the pinned file does not.
pinned_sums=briefing-binaries.sha256
# Where the assets are: this prefix, the release tag, then /<asset>. The tag is the bundle's
# tag_format (default %v: the bare dist version), so release_tag_prefix is empty; the assets are
# briefing-<version>-<platform> (.exe on Windows). BRIEFING_BINARY_BASE_URL replaces
# "<prefix><tag>" (tests serve a binary locally). That is safe from any source: nothing is kept
# or run unless its checksum is the pinned one.
release_url_prefix=https://github.com/Getty/briefing/releases/download/
release_tag_prefix=
# The binary cache: <claudeConfigDir>/briefing/bin/<version>/ - shared by every harness that
# starts this file.
cache_subdir=briefing/bin
# A PAR binary unpacks its archive into $PAR_GLOBAL_TEMP on its first start (seconds, under /tmp
# by default, which a reboot empties). Point it at a directory beside the binary and warm that
# once, right after the download, so no hook pays for the unpacking.
par_temp_var=PAR_GLOBAL_TEMP
warm_args=--version
download_connect_timeout=10
download_max_time=60
# Production assets are capped independently of the downloader's own limit handling.
download_max_bytes=268435456
# A failed SessionStart provision is retried after this modest fixed backoff. Tests inject
# BRIEFING_STARTER_NOW rather than sleeping; normal starts use `date +%s`.
retry_backoff_seconds=900
# --- end of the settings.

fail_status=1
[ "${1-}" = hook ] && fail_status=0 # a hook never fails
# Only `hook session-start` may provision. Prompt, background and move/tool hooks must not spend
# their hook budget on it, and CLI commands (--version, doctor, ...) are diagnostics that must not
# touch the network; they use a cached binary or the fallback.
can_provision=
session_start=
if [ "${1-}" = hook ] && [ "${2-}" = session-start ]; then
  can_provision=yes
  session_start=yes
fi

# Follow our own symlink chain to the real file: lib/, hooks/ and the pinned checksums sit
# next to the plugin's bin/, not the link's.
self=$0
while [ -L "$self" ]; do
  target=$(readlink -- "$self")
  case "$target" in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done
root=$(CDPATH='' cd -P -- "$(dirname -- "$self")/.." && pwd)

why_binary=
tmp=
download_tmp=
run_file=

# The supported release assets in their canonical order. A complete pin manifest has
# precisely these five entries, for one version, with no aliases or extra platforms.
platform_asset() {
  [ "$#" -eq 3 ] || return 1
  platform_os=$1
  platform_arch=$2
  platform_version=$3
  case $platform_version in
    [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) ;;
    *) return 1 ;;
  esac
  case $platform_version in *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._+-]*) return 1 ;; esac
  case $platform_os:$platform_arch in
    linux:x86_64 | linux:arm64 | macos:x86_64 | macos:arm64)
      printf 'briefing-%s-%s-%s\n' "$platform_version" "$platform_os" "$platform_arch"
      ;;
    windows:x86_64)
      printf 'briefing-%s-windows-x86_64.exe\n' "$platform_version"
      ;;
    *) return 1 ;;
  esac
}

# Read the local trust anchor as the exact canonical five-entry manifest. The values are
# kept in globals so find_binary can select only after the entire file was checked.
read_pins() {
  [ "$#" -eq 1 ] && [ -r "$1" ] || return 1
  pins_version=
  pin_linux_x86_64=
  pin_linux_arm64=
  pin_macos_x86_64=
  pin_macos_arm64=
  pin_windows_x86_64=
  pin_count=0

  while IFS= read -r pin_line; do
    pin_count=$((pin_count + 1))
    case $pin_count in
      1) pin_os=linux; pin_arch=x86_64 ;;
      2) pin_os=linux; pin_arch=arm64 ;;
      3) pin_os=macos; pin_arch=x86_64 ;;
      4) pin_os=macos; pin_arch=arm64 ;;
      5) pin_os=windows; pin_arch=x86_64 ;;
      *) return 1 ;;
    esac
    case $pin_line in *"  "*) ;;
      *) return 1 ;;
    esac
    pin_sum=${pin_line%%  *}
    pin_name=${pin_line#*  }
    [ "$pin_line" = "$pin_sum  $pin_name" ] || return 1
    case $pin_sum in '' | *[!0123456789abcdef]*) return 1 ;; esac
    [ "${#pin_sum}" -eq 64 ] || return 1

    pin_suffix=-$pin_os-$pin_arch
    [ "$pin_os" = windows ] && pin_suffix=$pin_suffix.exe
    case $pin_name in briefing-*) ;;
      *) return 1 ;;
    esac
    pin_line_version=${pin_name#briefing-}
    case $pin_line_version in *"$pin_suffix") ;;
      *) return 1 ;;
    esac
    pin_line_version=${pin_line_version%"$pin_suffix"}
    pin_expected=$(platform_asset "$pin_os" "$pin_arch" "$pin_line_version") || return 1
    [ "$pin_name" = "$pin_expected" ] || return 1
    if [ -z "$pins_version" ]; then
      pins_version=$pin_line_version
    elif [ "$pins_version" != "$pin_line_version" ]; then
      return 1
    fi

    case $pin_os:$pin_arch in
      linux:x86_64) pin_linux_x86_64=$pin_sum ;;
      linux:arm64) pin_linux_arm64=$pin_sum ;;
      macos:x86_64) pin_macos_x86_64=$pin_sum ;;
      macos:arm64) pin_macos_arm64=$pin_sum ;;
      windows:x86_64) pin_windows_x86_64=$pin_sum ;;
    esac
  done <"$1"

  [ "$pin_count" -eq 5 ] && [ -n "$pins_version" ] || return 1
  version=$pins_version
  return 0
}

# The SHA-256 of file $1, lower-case hex, from the operating system's native tool.
hash_file() {
  [ "$#" -eq 1 ] || return 1
  case $os in
    linux)
      command -v sha256sum >/dev/null 2>&1 || return 1
      hash_output=$(sha256sum <"$1" 2>/dev/null) || return 1
      hash_value=${hash_output%% *}
      ;;
    macos)
      command -v openssl >/dev/null 2>&1 || return 1
      hash_output=$(openssl dgst -sha256 "$1" 2>/dev/null) || return 1
      case $hash_output in *'= '*) hash_value=${hash_output##*= } ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
  case $hash_value in '' | *[!0123456789abcdef]*) return 1 ;; esac
  [ "${#hash_value}" -eq 64 ] || return 1
  printf '%s' "$hash_value"
}

# Refuse a symlink in every existing component of an absolute path. This is lexical on
# purpose: resolving a configured symlink would turn it into an accepted write target.
path_components_safe() {
  [ "$#" -eq 1 ] || return 1
  case $1 in /*) ;;
    *) return 1 ;;
  esac
  safe_path=
  safe_remaining=${1#/}
  while [ -n "$safe_remaining" ]; do
    case $safe_remaining in
      */*) safe_name=${safe_remaining%%/*}; safe_remaining=${safe_remaining#*/} ;;
      *) safe_name=$safe_remaining; safe_remaining= ;;
    esac
    case $safe_name in '' | . | ..) return 1 ;; esac
    safe_path=$safe_path/$safe_name
    [ ! -L "$safe_path" ] || return 1
  done
}

# Cache paths are fixed once the pin manifest and configuration root are known.
cache_components_safe() {
  [ "$#" -eq 1 ] || return 1
  [ "$1" = "$config_dir/$cache_subdir/$version" ] || return 1
  path_components_safe "$1"
}

# Create the cache one directory at a time and make every starter-owned directory private.
# The configuration root itself is left at the user's chosen mode when it already exists.
ensure_private_cache() {
  [ "$#" -eq 1 ] || return 1
  cache_components_safe "$1" || return 1
  if [ ! -d "$config_dir" ]; then
    mkdir -m 700 -- "$config_dir" 2>/dev/null || {
      [ ! -L "$config_dir" ] && [ -d "$config_dir" ] || return 1
    }
  fi

  private_path=$config_dir
  private_remaining=$cache_subdir/$version
  while [ -n "$private_remaining" ]; do
    case $private_remaining in
      */*) private_name=${private_remaining%%/*}; private_remaining=${private_remaining#*/} ;;
      *) private_name=$private_remaining; private_remaining= ;;
    esac
    [ -n "$private_name" ] || return 1
    private_path=$private_path/$private_name
    [ ! -L "$private_path" ] || return 1
    if [ ! -d "$private_path" ]; then
      mkdir -m 700 -- "$private_path" 2>/dev/null || {
        [ ! -L "$private_path" ] && [ -d "$private_path" ] || return 1
      }
    fi
    [ ! -L "$private_path" ] && [ -d "$private_path" ] || return 1
    command -p chmod 700 "$private_path" 2>/dev/null || return 1
  done
  cache_components_safe "$1"
}

# PAR's derived cache is not trusted as binary input, but it is still private cache state.
# Refuse non-directory entries and repair an existing directory before the binary uses it.
ensure_private_par_directory() {
  [ "$#" -eq 1 ] || return 1
  [ ! -L "$1" ] || return 1
  if [ -d "$1" ]; then
    command -p chmod 700 "$1" 2>/dev/null || return 1
  elif [ -f "$1" ]; then
    return 1
  fi
  return 0
}

# Exclusively create a private, non-executable temporary file beside the version directory.
# Keeping the process-owned file outside that final directory means a synchronized replacement
# of the version path cannot redirect downloader or cleanup operations into the replacement.
new_temp() {
  [ "$#" -eq 1 ] || return 1
  temp_parent=${1%/*}
  [ -n "$temp_parent" ] && [ "$temp_parent" != "$1" ] || return 1
  temp_try=0
  while [ "$temp_try" -lt 100 ]; do
    temp_candidate=$temp_parent/.$asset.$$.$temp_try.tmp
    if (set -C; : >"$temp_candidate") 2>/dev/null; then
      if chmod 600 "$temp_candidate" 2>/dev/null; then
        printf '%s\n' "$temp_candidate"
        return 0
      fi
      rm -f -- "$temp_candidate" 2>/dev/null
      return 1
    fi
    temp_try=$((temp_try + 1))
  done
  return 1
}

# Shell arithmetic accepts a leading zero as octal on some platforms. Keep timestamps canonical
# decimal before arithmetic so corrupt local state cannot end a hook with "Illegal number".
is_canonical_epoch() {
  case $1 in
    0) return 0 ;;
    [123456789]*)
      case $1 in *[!0123456789]*) return 1 ;; esac
      if [ "${#1}" -le 10 ]; then return 0; fi
      return 1
      ;;
    *) return 1 ;;
  esac
}

# The test-only clock fixture avoids sleeping through the retry interval. When set, it must be a
# canonical decimal epoch; an unavailable date or bad clock disables backoff rather than blocking.
now_epoch() {
  if [ "${BRIEFING_STARTER_NOW+x}" = x ]; then
    now=$BRIEFING_STARTER_NOW
  else
    now=$(date +%s 2>/dev/null)
  fi
  is_canonical_epoch "$now" || return 1
  printf '%s' "$now"
}

# A failed timestamp is deliberately only a best-effort throttle: it is untrusted local state,
# so malformed or unreadable contents never make the starter fail.
retry_backoff_active() {
  [ "$session_start" = yes ] && [ -f "$retry_file" ] || return 1
  failed_at=$(cat "$retry_file" 2>/dev/null)
  is_canonical_epoch "$failed_at" || return 1
  now=$(now_epoch) || return 1
  if [ "$now" -lt "$failed_at" ] 2>/dev/null; then return 0; fi
  elapsed=$((now - failed_at))
  [ "$elapsed" -lt "$retry_backoff_seconds" ]
}

record_failed_session_start() {
  [ "$session_start" = yes ] || return 0
  now=$(now_epoch) || return 0
  if ensure_private_cache "$cache_dir" && retry_tmp=$(new_temp "$cache_dir"); then
    if printf '%s\n' "$now" >"$retry_tmp" &&
      mv -f -- "$retry_tmp" "$retry_file" 2>/dev/null; then
      :
    else
      rm -f -- "$retry_tmp" 2>/dev/null
    fi
  fi
}

clear_failed_session_start() {
  rm -f -- "$retry_file" 2>/dev/null || :
}

# Trust boundary, stated honestly: the cache directory belongs to the user, and anyone who can
# write there can already run code as that user. What is verified is the binary file - its pinned
# hash is recomputed before every exec, and a download is checked before it is cached. The tree
# the binary unpacks beside itself (<binary>.par/) is NOT re-verified: it is derived state that
# the binary itself extracted, and checking it would defend nothing the user's own permissions
# do not already decide. A bad binary falls through to provision or the local engines.
verify_binary_file() {
  [ "$#" -eq 1 ] || return 1
  if ! actual_sum=$(hash_file "$1"); then
    why_binary="no native SHA-256 tool is there to verify the cached $asset"
    return 1
  fi
  if [ "$actual_sum" != "$sum" ]; then
    why_binary="the cached $asset does not match its pinned checksum and was refused"
    return 1
  fi
  return 0
}

verify_cached_binary() {
  verify_binary_file "$bin_file"
}

close_binary_run() {
  exec 9<&- || :
  run_file=
}

# No symlink in the cache directory chain, the binary, its PAR directory or the retry stamp.
cache_entry_safe() {
  cache_components_safe "$cache_dir" && [ ! -L "$bin_file" ] && [ ! -L "$par_dir" ] &&
    [ ! -L "$retry_file" ]
}

# Linux: open the candidate first, then hash and later exec only that open file description.
# Replacing its public cache path after this point cannot change which bytes receive execution
# authority. macOS refuses to execve a /dev/fd node, so there the run file is the absolute cache
# path inside the private 0700 cache: it is hashed here and again by start_binary_run, right
# before the exec. The platform decides, never a failing exec - a failed exec ends the starter.
prepare_binary_run() {
  [ "$#" -eq 1 ] || return 1
  close_binary_run
  if [ "$os" = macos ]; then
    verify_binary_file "$1" || return 1
    run_file=$bin_file
    return 0
  fi
  if ! exec 9<"$1"; then return 1; fi
  if [ -r /dev/fd/9 ]; then
    run_file=/dev/fd/9
  elif [ -r /proc/self/fd/9 ]; then
    run_file=/proc/self/fd/9
  else
    close_binary_run
    return 1
  fi
  if ! verify_binary_file "$run_file"; then
    close_binary_run
    return 1
  fi
  return 0
}

# Step 1 ends here: exec the prepared run file. On macOS the cache path is rehashed and the
# symlink and component checks are repeated immediately before the exec; a change falls through
# to the fallbacks.
start_binary_run() {
  if [ "$os" = macos ]; then
    if ! verify_binary_file "$run_file"; then
      close_binary_run
      return 1
    fi
    if ! cache_entry_safe || [ ! -f "$run_file" ]; then
      close_binary_run
      why_binary="the binary cache changed before the cached $asset could be started"
      return 1
    fi
  fi
  exec env "$par_temp_var=$par_dir" "$run_file" "$@"
}

# Steps 1 and 2. Sets bin_file and par_dir and returns 0 when the binary is there to run;
# else sets why_binary.
find_binary() {
  if [ ! -f "$root/bin/$pinned_sums" ]; then
    why_binary="no binary checksums are pinned in the plugin"
    return 1
  fi
  if ! read_pins "$root/bin/$pinned_sums"; then
    why_binary="the pinned binary checksum manifest is malformed"
    return 1
  fi

  system_name=$(uname -s 2>/dev/null)
  if [ "$BRIEFING_STARTER_TESTING" = 1 ] && [ "${BRIEFING_STARTER_TEST_OS+x}" = x ]; then
    system_name=$BRIEFING_STARTER_TEST_OS
  fi
  case $system_name in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    *) os= ;;
  esac
  case $(uname -m 2>/dev/null) in
    x86_64 | amd64) arch=x86_64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) arch= ;;
  esac
  if [ -z "$os" ] || [ -z "$arch" ]; then
    why_binary="no binary is built for this platform"
    return 1
  fi
  asset=$(platform_asset "$os" "$arch" "$version") || {
    why_binary="no binary checksum is pinned for $os-$arch"
    return 1
  }
  case $os:$arch in
    linux:x86_64) sum=$pin_linux_x86_64 ;;
    linux:arm64) sum=$pin_linux_arm64 ;;
    macos:x86_64) sum=$pin_macos_x86_64 ;;
    macos:arm64) sum=$pin_macos_arm64 ;;
    *) sum= ;;
  esac
  if [ -z "$sum" ]; then
    why_binary="no binary checksum is pinned for $os-$arch"
    return 1
  fi

  config_dir=${CLAUDE_CONFIG_DIR:-}
  if [ -z "$config_dir" ] && [ -n "${HOME:-}" ]; then config_dir=$HOME/.claude; fi
  case $config_dir in
    /*) ;;
    *)
      why_binary="no absolute CLAUDE_CONFIG_DIR or HOME to keep the binary in"
      return 1
      ;;
  esac
  cache_dir=$config_dir/$cache_subdir/$version
  # The checksum is part of the name: a cached binary is always the one this plugin pins,
  # even if a release were rebuilt under the same version.
  bin_file=$cache_dir/$asset-$sum
  par_dir=$bin_file.par
  retry_file=$cache_dir/.$asset.failed-at
  if ! cache_entry_safe; then
    why_binary="the binary cache contains a symlink and was refused"
    return 1
  fi
  if [ -f "$bin_file" ] && [ -x "$bin_file" ]; then
    if ! ensure_private_cache "$cache_dir"; then
      why_binary="cannot make the binary cache private"
      return 1
    fi
    if ! command -p chmod 700 "$bin_file" 2>/dev/null; then
      why_binary="cannot make the cached $asset private"
      return 1
    fi
    if ! ensure_private_par_directory "$par_dir"; then
      why_binary="cannot make the cached $asset PAR directory private"
      return 1
    fi
    if prepare_binary_run "$bin_file"; then
      clear_failed_session_start
      return 0
    fi
  fi
  if [ "$can_provision" != yes ]; then
    why_binary="the pinned binary is not cached; it is only downloaded by the SessionStart hook"
    return 1
  fi
  if retry_backoff_active; then
    why_binary="the last SessionStart binary provision failed; retrying after $retry_backoff_seconds seconds"
    return 1
  fi
  if fetch_binary; then
    clear_failed_session_start
    return 0
  fi
  record_failed_session_start
  return 1
}

# Step 2: privately download and check one process-owned file, warm only those verified
# bytes, then atomically link it into the shared cache. Sensitive cache operations use names
# relative to a directory entered before any downloader or installer can replace its path.
fetch_binary() {
  # Look for the platform's native SHA-256 implementation first: what cannot be checked is
  # not fetched.
  if ! hash_file /dev/null >/dev/null; then
    why_binary="no native SHA-256 tool is there to check a binary download"
    return 1
  fi
  if command -v curl >/dev/null 2>&1; then
    fetcher=curl
  elif command -v wget >/dev/null 2>&1; then
    fetcher=wget
  else
    why_binary="neither curl nor wget is there to download $asset"
    return 1
  fi
  max_bytes=$download_max_bytes
  if [ "$BRIEFING_STARTER_TESTING" = 1 ] &&
    [ "${BRIEFING_STARTER_TEST_MAX_BYTES+x}" = x ]; then
    if ! is_canonical_epoch "$BRIEFING_STARTER_TEST_MAX_BYTES"; then
      why_binary="the test-only binary download size limit is invalid"
      return 1
    fi
    max_bytes=$BRIEFING_STARTER_TEST_MAX_BYTES
  fi
  if ! ensure_private_cache "$cache_dir"; then
    why_binary="cannot create a private binary cache"
    return 1
  fi
  if ! tmp=$(new_temp "$cache_dir"); then
    why_binary="cannot exclusively create a binary download file"
    return 1
  fi
  fetch_origin=$(pwd -P 2>/dev/null) || {
    drop_download "cannot remember the caller directory while provisioning $asset"
    return 1
  }
  if ! CDPATH='' cd -P -- "$cache_dir" 2>/dev/null; then
    drop_download "cannot enter the binary cache safely"
    return 1
  fi
  bound_bin_file=./$asset-$sum
  bound_par_dir=$bound_bin_file.par

  if fetch_binary_bound; then fetch_status=0; else fetch_status=$?; fi
  if ! CDPATH='' cd -P -- "$fetch_origin" 2>/dev/null; then
    why_binary="cannot restore the caller directory after provisioning $asset"
    return 1
  fi
  return "$fetch_status"
}

bound_cache_safe() {
  cache_components_safe "$cache_dir" && [ ! -L "$retry_file" ]
}

fetch_binary_bound() {
  trap 'rm -f -- "$tmp" "$download_tmp" 2>/dev/null' EXIT
  trap 'rm -f -- "$tmp" "$download_tmp" 2>/dev/null; tmp=; download_tmp=; record_failed_session_start; exit $fail_status' HUP INT TERM
  download_url=${BRIEFING_BINARY_BASE_URL:-$release_url_prefix$release_tag_prefix$version}/$asset
  if ! download "$download_url" "$tmp" "$max_bytes" ||
    ! bound_cache_safe || [ -L "$bound_bin_file" ] || [ -L "$bound_par_dir" ] ||
    [ ! -f "$tmp" ] || [ -L "$tmp" ]; then
    drop_download "the download of $asset failed"
    return 1
  fi
  # Real curl and wget preserve the mode of the pre-created destination. Reassert it before
  # inspecting bytes so an injected test downloader cannot make unverified content executable.
  if ! chmod 600 "$tmp" 2>/dev/null || ! bound_cache_safe; then
    drop_download "the binary cache became unsafe after downloading $asset"
    return 1
  fi
  download_size=$(wc -c <"$tmp" 2>/dev/null) || download_size=
  set -- $download_size
  if [ "$#" -ne 1 ]; then
    drop_download "cannot determine the size of the downloaded $asset"
    return 1
  fi
  download_size=$1
  case $download_size in '' | *[!0123456789]*)
    drop_download "cannot determine the size of the downloaded $asset"
    return 1
    ;;
  esac
  if [ "$download_size" -gt "$max_bytes" ]; then
    drop_download "the downloaded $asset exceeds the size limit"
    return 1
  fi
  if ! downloaded_sum=$(hash_file "$tmp") || [ "$downloaded_sum" != "$sum" ]; then
    drop_download "the downloaded $asset does not match its pinned checksum and was refused"
    return 1
  fi
  if ! bound_cache_safe; then
    drop_download "the binary cache became unsafe before warming $asset"
    return 1
  fi

  # Preserve the prior warm-up contract: only verified bytes that run here can enter the cache.
  # Relative PAR and binary names remain bound to this entered directory if its public path is
  # replaced concurrently. $warm_args is split into words on purpose.
  if ! ensure_private_par_directory "$bound_par_dir" || ! bound_cache_safe; then
    drop_download "cannot make the $asset PAR directory private"
    return 1
  fi
  if ! chmod 700 "$tmp" 2>/dev/null || ! bound_cache_safe; then
    drop_download "the binary cache became unsafe before warming $asset"
    return 1
  fi
  if ! env "$par_temp_var=$bound_par_dir" "$tmp" $warm_args </dev/null >/dev/null 2>&1 ||
    ! bound_cache_safe || ! ensure_private_par_directory "$bound_par_dir"; then
    drop_download "the downloaded $asset does not run safely here"
    return 1
  fi

  installed_by_us=
  if ln -- "$tmp" "$bound_bin_file" 2>/dev/null; then
    installed_by_us=yes
  elif bound_cache_safe && [ ! -L "$bound_bin_file" ] && [ -f "$bound_bin_file" ] &&
    [ -x "$bound_bin_file" ] && verify_binary_file "$bound_bin_file"; then
    : # Another process installed the same pinned bytes first.
  else
    drop_download "cannot atomically install $asset in the binary cache"
    return 1
  fi

  if ! bound_cache_safe; then
    if [ "$installed_by_us" = yes ]; then rm -f -- "$bound_bin_file" 2>/dev/null; fi
    drop_download "the binary cache became unsafe while installing $asset"
    return 1
  fi
  if ! chmod 700 "$bound_bin_file" 2>/dev/null || ! bound_cache_safe ||
    ! prepare_binary_run "$bound_bin_file" || ! bound_cache_safe; then
    close_binary_run
    if [ "$installed_by_us" = yes ]; then rm -f -- "$bound_bin_file" 2>/dev/null; fi
    drop_download "the installed $asset could not be verified as a private cache entry"
    return 1
  fi
  if ! rm -f -- "$tmp" 2>/dev/null; then
    close_binary_run
    if [ "$installed_by_us" = yes ]; then rm -f -- "$bound_bin_file" 2>/dev/null; fi
    drop_download "cannot remove the private download name for $asset"
    return 1
  fi
  tmp=
  trap - EXIT HUP INT TERM
  return 0
}

# Fetch URL $1 into the already-created file $2, bounded in time and size and never reading
# the hook's stdin. Production's downloader protocol policy also covers every redirect.
download() {
  [ "$#" -eq 3 ] || return 1
  if [ "$BRIEFING_STARTER_TESTING" != 1 ]; then
    case $1 in https://*) ;;
      *) return 1 ;;
    esac
  fi

  if [ "$fetcher" = curl ]; then
    if [ "$BRIEFING_STARTER_TESTING" = 1 ]; then
      curl -fsSL --connect-timeout "$download_connect_timeout" --max-time "$download_max_time" \
        --max-filesize "$3" -o "$2" -- "$1" </dev/null >/dev/null 2>&1
    else
      curl -fsSL --connect-timeout "$download_connect_timeout" --max-time "$download_max_time" \
        --max-filesize "$3" --proto '=https' --proto-redir '=https' \
        -o "$2" -- "$1" </dev/null >/dev/null 2>&1
    fi
  elif [ "$BRIEFING_STARTER_TESTING" = 1 ]; then
    wget -q -T "$download_connect_timeout" -O "$2" -- "$1" </dev/null >/dev/null 2>&1
  else
    # Unlike curl, wget has no protocol allow-list whose result we can rely on across
    # implementations. Capture its response chain and accept only observed HTTP responses
    # whose absolute Location values remain HTTPS.
    download_tmp=$(new_temp "$cache_dir") || return 1
    if wget -T "$download_connect_timeout" --https-only --server-response \
      -O "$2" -- "$1" </dev/null >/dev/null 2>"$download_tmp"; then
      wget_status=0
    else
      wget_status=$?
    fi
    wget_saw_http=
    wget_safe_redirects=yes
    if [ "$wget_status" -eq 0 ]; then
      while IFS= read -r wget_line || [ -n "$wget_line" ]; do
        case $wget_line in *HTTP/*) wget_saw_http=yes ;; esac
        case $wget_line in
          *[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:*)
            wget_location=${wget_line#*[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:}
            wget_location=${wget_location#"${wget_location%%[![:space:]]*}"}
            case $wget_location in
              [Hh][Tt][Tt][Pp][Ss]://*) ;;
              *://*) wget_safe_redirects= ;;
            esac
            ;;
        esac
      done <"$download_tmp"
    fi
    rm -f -- "$download_tmp" 2>/dev/null
    download_tmp=
    [ "$wget_status" -eq 0 ] && [ "$wget_saw_http" = yes ] &&
      [ "$wget_safe_redirects" = yes ]
  fi
}

drop_download() {
  drop_reason=$1
  if [ -n "$tmp" ]; then rm -f -- "$tmp" 2>/dev/null; fi
  if [ -n "$download_tmp" ]; then rm -f -- "$download_tmp" 2>/dev/null; fi
  tmp=
  download_tmp=
  trap - EXIT HUP INT TERM
  if [ -n "$drop_reason" ]; then why_binary=$drop_reason; fi
}

# Step 3, hooks and the doctor: the Python reference, which needs nothing but python3.
find_python() {
  if command -v python3 >/dev/null 2>&1; then python=python3
  elif command -v python >/dev/null 2>&1; then python=python
  else
    why_python="python3 was not found on PATH"
    return 1
  fi
  if [ ! -f "$root/hooks/briefing-preload" ]; then
    why_python="hooks/briefing-preload is missing"
    return 1
  fi
  return 0
}

# Step 3, everything else: the plugin's Perl, once its modules load.
find_perl() {
  if ! command -v perl >/dev/null 2>&1; then
    why_perl="perl was not found on PATH"
    return 1
  fi
  if [ ! -f "$root/script/briefing" ]; then
    why_perl="script/briefing is missing"
    return 1
  fi
  if ! perl -I"$root/lib" -e 'require App::Briefing::CLI' </dev/null >/dev/null 2>&1; then
    why_perl="this perl does not load App::Briefing (Moo, Path::Tiny, JSON::MaybeXS, TOML::Tiny are needed)"
    return 1
  fi
  return 0
}

if find_binary && [ -n "$run_file" ]; then
  start_binary_run "$@"
fi

why_python=
why_perl=
case ${1-} in
  hook)
    if find_python; then exec "$python" "$root/hooks/briefing-preload"; fi
    why_other=$why_python
    ;;
  doctor)
    use_perl=
    for argument in "$@"; do [ "$argument" = --tsv ] && use_perl=yes; done
    if [ -z "$use_perl" ] && find_python; then exec "$python" "$root/hooks/briefing-preload" "$@"; fi
    if find_perl; then exec perl -I"$root/lib" "$root/script/briefing" "$@"; fi
    why_other="$why_python; $why_perl"
    ;;
  *)
    if find_perl; then exec perl -I"$root/lib" "$root/script/briefing" "$@"; fi
    why_other=$why_perl
    ;;
esac

# Step 4. Every part of the line is fixed text or a checked $why_binary - nothing in it needs
# JSON escaping.
message="briefing: no binary ($why_binary) and no fallback ($why_other)."
if [ "$fail_status" -eq 0 ]; then
  printf '{"systemMessage":"%s"}\n' "$message"
else
  printf '%s\n' "$message" >&2
fi
exit "$fail_status"
